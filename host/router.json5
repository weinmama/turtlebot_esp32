{
  mode: "router",
  listen: { endpoints: ["tcp/0.0.0.0:7447"] },
  scouting: { multicast: { enabled: true } },
  // ROS discovery tokens must be routed between MCU and host sessions.
  routing: { router: { peers_failover_brokering: true } },
  adminspace: { enabled: true, permissions: { read: true, write: false } },
}
